NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173
TZ=Asia/Jakarta

# Database
# TiDB Cloud : port 4000 dan DB_SSL=true
# MySQL lokal: port 3306 dan DB_SSL=false
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=attendance
DB_SSL=false

# Secret: ganti dengan string acak panjang (minimal 32 karakter)
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRES_IN=8h
QR_SECRET=ganti-dengan-string-acak-lain-minimal-32-karakter

# true = jalankan cron (alpa otomatis, dll)
RUN_JOBS=false
